# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# NASA Earthdata Login (https://urs.earthdata.nasa.gov): needed for IMERG / MERRA-2 / MODIS downloads.
# Each teammate uses their own account.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ESA EarthCARE (MAAP): generate an access token yourself after logging in with EO Sign In
# (https://portal.maap.eo.esa.int, see https://explorer.maap.eo.esa.int/user-guide). Tokens expire: regenerate when refused.
ESA_MAAP_TOKEN=
# The MAAP token page shows a code example with a client secret for the "offline-token" client; copy it here.
ESA_MAAP_CLIENT_SECRET=

# Backend API protections (all optional; defaults in src/earth_detective/backend/core/settings.py)
# Team key for POST /explain (expert review). Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
TEAM_API_KEY=
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_HEAVY_PER_MINUTE=20
# MAX_BODY_BYTES=32768
# MAX_INVESTIGATIONS=500
# INVESTIGATION_TTL_DAYS=7
# TRUST_PROXY_HEADERS=false
