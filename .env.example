# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# NASA Earthdata Login (https://urs.earthdata.nasa.gov): needed for IMERG / MERRA-2 / MODIS downloads.
# Each teammate uses their own account.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ESA EarthCARE (MAAP): generate an access token yourself after logging in with EO Sign In
# (https://portal.maap.eo.esa.int, see https://explorer.maap.eo.esa.int/user-guide). Tokens expire: regenerate when refused.
ESA_MAAP_TOKEN=
